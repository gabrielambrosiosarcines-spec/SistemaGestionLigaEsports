                  "const body = pm.response.json();",
                  "pm.expect(body.estado).to.eql('InscripcionesAbiertas');"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscribir los ocho equipos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/inscripciones",
            "body": {
              "mode": "raw",
              "raw": "{\"EquipoId\": \"{{equipo01Id}}\", \"TorneoId\": \"{{torneoId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El pre-request registra los equipos 02 a 08; esta solicitud registra el equipo 01."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "const base = pm.variables.replaceIn('{{baseUrl}}');",
                  "const tournamentId = pm.collectionVariables.get('torneoId');",
                  "const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('accessToken') };",
                  "const teamIds = [2, 3, 4, 5, 6, 7, 8].map(function (index) {",
                  "    return pm.collectionVariables.get('equipo' + String(index).padStart(2, '0') + 'Id');",
                  "});",
                  "",
                  "function next(index) {",
                  "    if (index === teamIds.length) {",
                  "        return;",
                  "    }",
                  "    pm.sendRequest({",
                  "        url: base + '/api/inscripciones',",
                  "        method: 'POST',",
                  "        header: headers,",
                  "        body: {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify({",
                  "                EquipoId: teamIds[index],",
                  "                TorneoId: tournamentId",
                  "            })",
                  "        }",
                  "    }, function (error, response) {",
                  "        if (error || response.code < 200 || response.code >= 300) {",
                  "            pm.collectionVariables.set('enrollmentError', error ? error.message : String(response.code));",
                  "            return;",
                  "        }",
                  "        next(index + 1);",
                  "    });",
                  "}",
                  "",
                  "pm.collectionVariables.unset('enrollmentError');",
                  "next(0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "pm.test('La inscripción principal tiene id', function () { pm.expect(body.id).to.be.a('string').and.not.empty; });",
                  "pm.expect(pm.collectionVariables.get('enrollmentError')).to.be.empty;",
                  "pm.collectionVariables.set('inscripcionId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Iniciar torneo",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/torneos/{{torneoId}}",
            "body": {
              "mode": "raw",
              "raw": "{\"Nombre\": \"Torneo compacto-{{runId}}\", \"FechaInicio\": \"2030-01-01T10:00:00Z\", \"FechaFin\": null, \"Capacidad\": 8, \"Estado\": \"EnCurso\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
