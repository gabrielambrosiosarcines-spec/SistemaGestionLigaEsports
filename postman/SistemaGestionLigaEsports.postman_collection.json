    {
      "name": "01 - Preparación y validaciones",
      "item": [
        {
          "name": "Preparar escenario: 8 equipos completos",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/equipos",
            "description": "Crea automáticamente 40 jugadores, 8 equipos y asigna 5 jugadores activos a cada equipo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text",
                "exec": [
                  "pm.collectionVariables.set('runId', String(Date.now()));",
                  "pm.collectionVariables.unset('setupError');",
                  "const base = pm.variables.replaceIn('{{baseUrl}}');",
                  "const headers = { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + pm.collectionVariables.get('accessToken') };",
                  "const players = {};",
                  "const teams = {};",
                  "",
                  "function send(method, path, body, done) {",
                  "    pm.sendRequest({",
                  "        url: base + path,",
                  "        method: method,",
                  "        header: headers,",
                  "        body: body === null ? undefined : {",
                  "            mode: 'raw',",
                  "            raw: JSON.stringify(body)",
                  "        }",
                  "    }, function (error, response) {",
                  "        if (error) {",
                  "            done(error);",
                  "            return;",
                  "        }",
                  "        if (response.code < 200 || response.code >= 300) {",
                  "            done(new Error(method + ' ' + path + ' devolvió ' + response.code));",
                  "            return;",
                  "        }",
                  "        let data = {};",
                  "        try {",
                  "            data = response.json();",
                  "        } catch (_) {",
                  "        }",
                  "        done(null, data);",
                  "    });",
                  "}",
                  "",
                  "function series(values, action, done) {",
                  "    let position = 0;",
                  "    function next(error) {",
                  "        if (error || position === values.length) {",
                  "            done(error);",
                  "            return;",
                  "        }",
                  "        const value = values[position++];",
                  "        action(value, next);",
                  "    }",
                  "    next();",
                  "}",
                  "",
                  "function fail(error) {",
                  "    pm.collectionVariables.set('setupError', error.message);",
                  "    console.error(error);",
                  "}",
                  "",
                  "const playerIndexes = Array.from({ length: 40 }, (_, index) => index + 1);",
                  "series(playerIndexes, function (index, next) {",
                  "    const nickname = 'compacto-jugador-' + String(index).padStart(2, '0') + '-' + pm.collectionVariables.get('runId');",
                  "    send('POST', '/api/jugadores', {",
                  "        Nickname: nickname,",
                  "        Nombre: 'Jugador compacto ' + index,",
                  "        Activo: true",
                  "    }, function (error, data) {",
                  "        if (!error) {",
                  "            players[index] = data.id;",
                  "            if (index === 1) {",
                  "                pm.collectionVariables.set('jugador01Nickname', nickname);",
                  "                pm.collectionVariables.set('jugador01Id', data.id);",
                  "            }",
                  "        }",
                  "        next(error);",
                  "    });",
                  "}, function (error) {",
                  "    if (error) {",
                  "        fail(error);",
                  "        return;",
                  "    }",
                  "",
                  "    const teamIndexes = Array.from({ length: 8 }, (_, index) => index + 1);",
                  "    series(teamIndexes, function (index, next) {",
                  "        send('POST', '/api/equipos', {",
                  "            Nombre: 'Equipo compacto ' + String(index).padStart(2, '0') + '-' + pm.collectionVariables.get('runId'),",
                  "            Activo: true",
                  "        }, function (error, data) {",
                  "            if (!error) {",
                  "                teams[index] = data.id;",
                  "                pm.collectionVariables.set('equipo' + String(index).padStart(2, '0') + 'Id', data.id);",
                  "            }",
                  "            next(error);",
                  "        });",
                  "    }, function (error) {",
                  "        if (error) {",
                  "            fail(error);",
                  "            return;",
                  "        }",
                  "",
                  "        series(teamIndexes, function (teamIndex, nextTeam) {",
                  "            const firstPlayer = (teamIndex - 1) * 5 + 1;",
                  "            const teamPlayers = Array.from({ length: 5 }, (_, index) => firstPlayer + index);",
                  "            series(teamPlayers, function (playerIndex, nextPlayer) {",
                  "                send('POST', '/api/equipos/' + teams[teamIndex] + '/jugadores/' + players[playerIndex], null, nextPlayer);",
                  "            }, nextTeam);",
                  "        }, function (error) {",
                  "            if (error) {",
                  "                fail(error);",
                  "                return;",
                  "            }",
                  "            pm.collectionVariables.set('setupReady', 'true');",
                  "        });",
                  "    });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Hay ocho equipos preparados', function () {",
                  "    pm.expect(pm.collectionVariables.get('setupError')).to.be.empty;",
                  "    pm.expect(body).to.be.an('array').with.length(8);",
                  "});"
                ]
              }
            }
          ]
        },
