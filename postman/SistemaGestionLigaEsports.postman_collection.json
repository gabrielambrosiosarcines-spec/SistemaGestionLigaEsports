            "body": {
              "mode": "raw",
              "raw": "{\"Nombre\": \"Torneo compacto-{{runId}}\", \"FechaInicio\": \"2030-01-01T10:00:00Z\", \"FechaFin\": null, \"Capacidad\": 8, \"Estado\": \"InscripcionesAbiertas\"}",
              "options": {
